# patrol-bs Configuration File
# 
# Copy this file to ~/.patrol-bs.conf or .patrol-bs.conf in your project root.
# Values can be overridden by environment variables (PATROL_BS_*) or CLI arguments.
#

# BrowserStack credentials (username:access_key)
# Get yours at: https://www.browserstack.com/accounts/settings
# credentials=your_username:your_access_key

# Project name displayed in BrowserStack dashboard
# project=MyProject

# Idle timeout in seconds (default: 240)
# timeout=240

# Network profile: reset, 2g-gprs-lossy, etc.
# network_profile=reset

# Android devices (JSON array)
# See available devices: https://www.browserstack.com/list-of-browsers-and-platforms/app_automate
# android_devices=["Samsung Galaxy S24-14.0", "Google Pixel 8-14.0"]

# Android tablet devices
# android_tablets=["Samsung Galaxy Tab S9-14.0"]

# iOS devices (JSON array)
# ios_devices=["iPhone 15 Pro-17", "iPhone 16 Pro Max-18"]

# iOS tablet devices
# ios_tablets=["iPad Pro 12.9 2022-16"]

