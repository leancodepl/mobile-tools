#!/usr/bin/env bash
#
# patrol-bs-android - Android subcommand for patrol-bs
#
# This file is sourced by patrol-bs and should not be executed directly.
#

# =============================================================================
# HELP
# =============================================================================

show_android_help() {
    cat <<'EOF'
patrol-bs android - Build and upload Android APKs to BrowserStack

USAGE:
    patrol-bs android [options] [-- patrol_args...]

OPTIONS:
    --credentials <user:key>    BrowserStack credentials
    --project <name>            Project name on BrowserStack
    --devices <json>            JSON array of devices to test on
    --tablets                   Use tablet devices instead of phones
    --config <dev|prod>         Build configuration
    --flavor <name>             Android build flavor
    --timeout <seconds>         Idle timeout (default: 240)
    --network-profile <name>    Network profile (default: reset)
    --slow-internet             Use slow internet (2g-gprs-lossy)
    --skip-build                Skip building, only upload existing APKs
    --build-tag <tag>           Custom build tag for BrowserStack
    -h, --help                  Show this help message

    Any other arguments are passed through to 'patrol build android'.

ENVIRONMENT VARIABLES:
    PATROL_BS_CREDENTIALS       BrowserStack credentials
    PATROL_BS_PROJECT           Project name
    PATROL_BS_ANDROID_DEVICES   Default devices JSON array
    PATROL_BS_ANDROID_TABLETS   Tablet devices JSON array
    PATROL_BS_TIMEOUT           Idle timeout

DEFAULT DEVICES:
    If not specified, uses: ["Google Pixel 8-14.0"]

EXAMPLES:
    # Basic usage with target
    patrol-bs android --target integration_test/app_test.dart

    # With specific devices and flavor
    patrol-bs android --devices '["Samsung Galaxy S24-14.0"]' --flavor dev

    # Skip build (use existing APKs)
    patrol-bs android --skip-build

    # Pass arguments to patrol
    patrol-bs android -- --exclude some_test.dart
EOF
}

# =============================================================================
# MAIN COMMAND
# =============================================================================

cmd_android() {
    # Load configuration
    load_config
    
    # Set Android-specific defaults if not set by config/env
    : "${ANDROID_DEVICES:='["Google Pixel 8-14.0"]'}"
    : "${ANDROID_TABLETS:='["Samsung Galaxy Tab S9-14.0"]'}"
    
    # Parse arguments
    if ! parse_build_args "android" "$@"; then
        show_android_help
        exit 0
    fi
    
    # Validate required settings
    require_credentials
    require_project
    require_command "jq"
    require_command "curl"
    
    # Try to read config from pubspec if not set
    if [[ -z "$CONFIG" ]]; then
        CONFIG=$(read_config_from_pubspec "android") || true
    fi
    
    # Use flavor from config if not explicitly set
    if [[ -z "$FLAVOR" && -n "$CONFIG" ]]; then
        FLAVOR="$CONFIG"
    fi
    
    # Determine build type for tagging
    determine_build_type "${PATROL_ARGS[@]:-}"
    
    local env
    env=$(detect_environment)
    
    if [[ -z "$BUILD_TAG" ]]; then
        BUILD_TAG="$env:$BUILD_TYPE"
    fi
    
    # Build flavor-specific paths
    local flavor_separator="-"
    local flavor_dir="/"
    if [[ -n "$FLAVOR" ]]; then
        flavor_separator="-$FLAVOR-"
        flavor_dir="/$FLAVOR/"
    fi
    
    # Log configuration
    log_info "Project: $PROJECT"
    log_info "Devices: $ANDROID_DEVICES"
    log_info "Network profile: $NETWORK_PROFILE"
    log_info "Timeout: $TIMEOUT"
    log_info "Build tag: $BUILD_TAG"
    [[ -n "$CONFIG" ]] && log_info "Config: $CONFIG"
    [[ -n "$FLAVOR" ]] && log_info "Flavor: $FLAVOR"
    
    # Build the app
    if [[ "$SKIP_BUILD" != 1 ]]; then
        log_step "Building Android app..."
        
        local build_args=()
        [[ -n "$CONFIG" ]] && build_args+=("--config" "$CONFIG")
        
        if ! patrol build android "${build_args[@]}" "${PATROL_ARGS[@]:-}" >&2; then
            log_error "Build failed"
            exit 1
        fi
    else
        log_info "Skipping build (--skip-build)"
    fi
    
    # Find APK files
    log_step "Locating APK files..."
    
    local app_apk
    app_apk=$(find "$PWD" -name "app${flavor_separator}debug.apk" -path "*/outputs/apk/*" 2>/dev/null | head -1)
    
    if [[ -z "$app_apk" || ! -f "$app_apk" ]]; then
        # Try alternative path structure
        app_apk=$(find "$PWD" -name "app${flavor_separator}debug.apk" -path "*${flavor_dir}debug/*" 2>/dev/null | head -1)
    fi
    
    if [[ -z "$app_apk" || ! -f "$app_apk" ]]; then
        log_error "Could not find main app APK"
        log_info "Expected pattern: app${flavor_separator}debug.apk in */outputs/apk/*"
        exit 1
    fi
    
    log_info "Found app APK: $app_apk"
    
    local test_apk
    test_apk=$(find "$PWD" -name "app${flavor_separator}debug-androidTest.apk" -path "*/outputs/apk/*" 2>/dev/null | head -1)
    
    if [[ -z "$test_apk" || ! -f "$test_apk" ]]; then
        # Try alternative path structure
        test_apk=$(find "$PWD" -name "app${flavor_separator}debug-androidTest.apk" -path "*androidTest${flavor_dir}debug/*" 2>/dev/null | head -1)
    fi
    
    if [[ -z "$test_apk" || ! -f "$test_apk" ]]; then
        log_error "Could not find test APK"
        log_info "Expected pattern: app${flavor_separator}debug-androidTest.apk in */outputs/apk/*"
        exit 1
    fi
    
    log_info "Found test APK: $test_apk"
    
    # Upload app APK
    log_step "Uploading app APK..."
    
    local app_response
    if ! app_response=$(bs_upload "/app-automate/espresso/v2/app" "$app_apk"); then
        log_error "Failed to upload app APK"
        echo "$app_response" >&2
        exit 1
    fi
    
    local app_url
    app_url=$(echo "$app_response" | jq --raw-output .app_url)
    log_success "Uploaded app: $app_url"
    
    # Upload test APK
    log_step "Uploading test APK..."
    
    local test_response
    if ! test_response=$(bs_upload "/app-automate/espresso/v2/test-suite" "$test_apk"); then
        log_error "Failed to upload test APK"
        echo "$test_response" >&2
        exit 1
    fi
    
    local test_url
    test_url=$(echo "$test_response" | jq --raw-output .test_suite_url)
    log_success "Uploaded test: $test_url"
    
    # Schedule test execution
    log_step "Scheduling test execution..."
    
    local run_response
    if ! run_response=$(bs_api POST "/app-automate/espresso/v2/build" \
        -H "Content-Type: application/json" \
        --data-binary @- <<EOF
{
    "app": "$app_url",
    "testSuite": "$test_url",
    "project": "$PROJECT",
    "devices": $ANDROID_DEVICES,
    "singleRunnerInvocation": true,
    "useOrchestrator": true,
    "clearPackageData": true,
    "deviceLogs": true,
    "enableResultBundle": true,
    "networkLogs": false,
    "local": false,
    "networkProfile": "$NETWORK_PROFILE",
    "idleTimeout": $TIMEOUT,
    "buildTag": "$BUILD_TAG"
}
EOF
    ); then
        log_error "Failed to schedule test execution"
        echo "$run_response" >&2
        exit 1
    fi
    
    log_success "Test execution scheduled"
    echo "$run_response" >&2
    
    # Output build ID (stdout for scripting)
    local build_id
    build_id=$(echo "$run_response" | jq --raw-output .build_id)
    echo "$build_id"
}

