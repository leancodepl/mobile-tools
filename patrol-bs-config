#!/usr/bin/env bash
#
# patrol-bs-config - Configuration management subcommand for patrol-bs
#
# This file is sourced by patrol-bs and should not be executed directly.
#

# =============================================================================
# CONSTANTS
# =============================================================================

# XDG Base Directory Specification compliant config location
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/patrol-bs"
ACTIVE_PROFILE_FILE="$CONFIG_DIR/.active_profile"

# =============================================================================
# HELP
# =============================================================================

show_config_help() {
    cat <<'EOF'
patrol-bs config - Manage patrol-bs configuration

USAGE:
    patrol-bs config <subcommand> [options]

SUBCOMMANDS:
    init                    Interactive configuration setup
    set <key> <value>       Set a configuration value
    get <key>               Get a configuration value
    unset <key>             Remove a configuration value
    list                    List all configuration values
    path                    Show configuration file path
    
    Profile Management:
    create <name>           Create a new named profile
    use <name>              Switch to a named profile
    profiles                List all available profiles
    current                 Show current active profile

CONFIGURATION KEYS:
    credentials             BrowserStack credentials (username:access_key)
    project                 Project name on BrowserStack
    timeout                 Idle timeout in seconds
    network_profile         Network profile (reset, 2g-gprs-lossy, etc.)
    android.devices         Default Android devices (JSON array)
    android.tablets         Android tablet devices (JSON array)
    ios.devices             Default iOS devices (JSON array)
    ios.tablets             iOS tablet devices (JSON array)

EXAMPLES:
    # Interactive setup
    patrol-bs config init

    # Set credentials
    patrol-bs config set credentials "username:access_key"

    # Set project name
    patrol-bs config set project "MyApp"

    # Set Android devices
    patrol-bs config set android.devices '["Samsung Galaxy S24-14.0"]'

    # Create and use a profile for production
    patrol-bs config create production
    patrol-bs config use production
    patrol-bs config set project "MyApp-Prod"

    # View all settings
    patrol-bs config list
EOF
}

# =============================================================================
# CONFIG FILE MANAGEMENT
# =============================================================================

# Get the config file path for a profile
get_config_file() {
    local profile="${1:-default}"
    if [[ "$profile" == "default" ]]; then
        echo "$CONFIG_DIR/config"
    else
        echo "$CONFIG_DIR/config_$profile"
    fi
}

# Get the current active profile name
get_active_profile() {
    if [[ -f "$ACTIVE_PROFILE_FILE" ]]; then
        cat "$ACTIVE_PROFILE_FILE"
    else
        echo "default"
    fi
}

# Set the active profile
set_active_profile() {
    local profile="$1"
    mkdir -p "$CONFIG_DIR"
    echo "$profile" > "$ACTIVE_PROFILE_FILE"
}

# Ensure config directory exists
ensure_config_dir() {
    if [[ ! -d "$CONFIG_DIR" ]]; then
        mkdir -p "$CONFIG_DIR"
        log_info "Created config directory: $CONFIG_DIR"
    fi
}

# Convert dot notation key to config file key
# e.g., "android.devices" -> "android_devices"
normalize_key() {
    echo "$1" | tr '.' '_'
}

# =============================================================================
# CONFIG OPERATIONS
# =============================================================================

# Read a value from config file
config_read() {
    local key="$1"
    local config_file="$2"
    
    key=$(normalize_key "$key")
    
    if [[ ! -f "$config_file" ]]; then
        return 1
    fi
    
    while IFS='=' read -r k v; do
        # Skip empty lines and comments
        [[ -z "$k" || "$k" =~ ^[[:space:]]*# ]] && continue
        
        # Trim whitespace
        k=$(echo "$k" | xargs)
        v=$(echo "$v" | xargs)
        
        if [[ "$k" == "$key" ]]; then
            echo "$v"
            return 0
        fi
    done < "$config_file"
    
    return 1
}

# Write a value to config file
config_write() {
    local key="$1"
    local value="$2"
    local config_file="$3"
    
    key=$(normalize_key "$key")
    ensure_config_dir
    
    # Create file if it doesn't exist
    touch "$config_file"
    
    # Check if key already exists
    if grep -q "^${key}=" "$config_file" 2>/dev/null; then
        # Update existing key (macOS compatible sed)
        if [[ "$(uname)" == "Darwin" ]]; then
            sed -i '' "s|^${key}=.*|${key}=${value}|" "$config_file"
        else
            sed -i "s|^${key}=.*|${key}=${value}|" "$config_file"
        fi
    else
        # Add new key
        echo "${key}=${value}" >> "$config_file"
    fi
}

# Remove a value from config file
config_remove() {
    local key="$1"
    local config_file="$2"
    
    key=$(normalize_key "$key")
    
    if [[ ! -f "$config_file" ]]; then
        return 1
    fi
    
    # Remove key (macOS compatible sed)
    if [[ "$(uname)" == "Darwin" ]]; then
        sed -i '' "/^${key}=/d" "$config_file"
    else
        sed -i "/^${key}=/d" "$config_file"
    fi
}

# List all values in config file
config_list() {
    local config_file="$1"
    
    if [[ ! -f "$config_file" ]]; then
        log_warn "No configuration file found"
        return 1
    fi
    
    while IFS='=' read -r k v; do
        # Skip empty lines and comments
        [[ -z "$k" || "$k" =~ ^[[:space:]]*# ]] && continue
        
        # Trim whitespace
        k=$(echo "$k" | xargs)
        v=$(echo "$v" | xargs)
        
        # Mask credentials
        if [[ "$k" == "credentials" ]]; then
            local user="${v%%:*}"
            v="${user}:****"
        fi
        
        printf "  %s = %s\n" "$k" "$v"
    done < "$config_file"
}

# =============================================================================
# INTERACTIVE SETUP
# =============================================================================

config_init() {
    local profile
    profile=$(get_active_profile)
    local config_file
    config_file=$(get_config_file "$profile")
    
    echo ""
    echo "patrol-bs Configuration Setup"
    echo "=============================="
    echo ""
    echo "This will help you configure patrol-bs for BrowserStack testing."
    echo "Press Enter to keep existing values (shown in brackets)."
    echo ""
    
    # Credentials
    local current_creds
    current_creds=$(config_read "credentials" "$config_file" 2>/dev/null) || current_creds=""
    local masked_creds=""
    if [[ -n "$current_creds" ]]; then
        local user="${current_creds%%:*}"
        masked_creds="${user}:****"
    fi
    
    printf "BrowserStack credentials (username:access_key)"
    [[ -n "$masked_creds" ]] && printf " [%s]" "$masked_creds"
    printf ": "
    read -r input_creds
    
    if [[ -n "$input_creds" ]]; then
        if [[ "$input_creds" != *":"* ]]; then
            log_error "Credentials must be in format 'username:access_key'"
            return 1
        fi
        config_write "credentials" "$input_creds" "$config_file"
        log_success "Credentials saved"
    fi
    
    # Project name
    local current_project
    current_project=$(config_read "project" "$config_file" 2>/dev/null) || current_project=""
    
    printf "Project name"
    [[ -n "$current_project" ]] && printf " [%s]" "$current_project"
    printf ": "
    read -r input_project
    
    if [[ -n "$input_project" ]]; then
        config_write "project" "$input_project" "$config_file"
        log_success "Project name saved"
    fi
    
    # Timeout
    local current_timeout
    current_timeout=$(config_read "timeout" "$config_file" 2>/dev/null) || current_timeout="240"
    
    printf "Idle timeout in seconds [%s]: " "$current_timeout"
    read -r input_timeout
    
    if [[ -n "$input_timeout" ]]; then
        if ! [[ "$input_timeout" =~ ^[0-9]+$ ]]; then
            log_error "Timeout must be a number"
            return 1
        fi
        config_write "timeout" "$input_timeout" "$config_file"
        log_success "Timeout saved"
    fi
    
    # Android devices
    local current_android
    current_android=$(config_read "android_devices" "$config_file" 2>/dev/null) || current_android=""
    
    echo ""
    echo "Android devices (JSON array, e.g., '[\"Samsung Galaxy S24-14.0\"]')"
    [[ -n "$current_android" ]] && printf "  Current: %s\n" "$current_android"
    printf "  New value (or press Enter to skip): "
    read -r input_android
    
    if [[ -n "$input_android" ]]; then
        if ! echo "$input_android" | jq empty 2>/dev/null; then
            log_error "Invalid JSON array"
            return 1
        fi
        config_write "android_devices" "$input_android" "$config_file"
        log_success "Android devices saved"
    fi
    
    # iOS devices
    local current_ios
    current_ios=$(config_read "ios_devices" "$config_file" 2>/dev/null) || current_ios=""
    
    echo ""
    echo "iOS devices (JSON array, e.g., '[\"iPhone 15 Pro-17\"]')"
    [[ -n "$current_ios" ]] && printf "  Current: %s\n" "$current_ios"
    printf "  New value (or press Enter to skip): "
    read -r input_ios
    
    if [[ -n "$input_ios" ]]; then
        if ! echo "$input_ios" | jq empty 2>/dev/null; then
            log_error "Invalid JSON array"
            return 1
        fi
        config_write "ios_devices" "$input_ios" "$config_file"
        log_success "iOS devices saved"
    fi
    
    echo ""
    log_success "Configuration complete!"
    echo ""
    echo "Configuration saved to: $config_file"
    echo "Active profile: $profile"
    echo ""
    echo "You can now run:"
    echo "  patrol-bs android --target integration_test/app_test.dart"
    echo "  patrol-bs ios --target integration_test/app_test.dart"
    echo ""
}

# =============================================================================
# PROFILE MANAGEMENT
# =============================================================================

config_create_profile() {
    local name="$1"
    
    if [[ -z "$name" ]]; then
        log_error "Profile name is required"
        echo "Usage: patrol-bs config create <name>" >&2
        return 1
    fi
    
    if [[ "$name" == "default" ]]; then
        log_error "Cannot create a profile named 'default'"
        return 1
    fi
    
    local config_file
    config_file=$(get_config_file "$name")
    
    if [[ -f "$config_file" ]]; then
        log_error "Profile '$name' already exists"
        return 1
    fi
    
    ensure_config_dir
    touch "$config_file"
    
    log_success "Created profile: $name"
    echo "To use this profile, run: patrol-bs config use $name"
}

config_use_profile() {
    local name="$1"
    
    if [[ -z "$name" ]]; then
        log_error "Profile name is required"
        echo "Usage: patrol-bs config use <name>" >&2
        return 1
    fi
    
    local config_file
    config_file=$(get_config_file "$name")
    
    if [[ "$name" != "default" && ! -f "$config_file" ]]; then
        log_error "Profile '$name' does not exist"
        echo "Create it with: patrol-bs config create $name" >&2
        return 1
    fi
    
    set_active_profile "$name"
    log_success "Switched to profile: $name"
}

config_list_profiles() {
    ensure_config_dir
    
    local active
    active=$(get_active_profile)
    
    echo "Available profiles:"
    
    # Default profile
    if [[ "$active" == "default" ]]; then
        echo "  * default (active)"
    else
        echo "    default"
    fi
    
    # Named profiles
    for file in "$CONFIG_DIR"/config_*; do
        [[ -f "$file" ]] || continue
        local name="${file##*/config_}"
        if [[ "$active" == "$name" ]]; then
            echo "  * $name (active)"
        else
            echo "    $name"
        fi
    done
}

# =============================================================================
# MAIN COMMAND
# =============================================================================

cmd_config() {
    if [[ $# -eq 0 ]]; then
        show_config_help
        exit 0
    fi
    
    local subcommand="$1"
    shift
    
    local profile
    profile=$(get_active_profile)
    local config_file
    config_file=$(get_config_file "$profile")
    
    case "$subcommand" in
        -h|--help)
            show_config_help
            exit 0
            ;;
        init)
            config_init
            ;;
        set)
            local key="$1"
            local value="$2"
            
            if [[ -z "$key" || -z "$value" ]]; then
                log_error "Usage: patrol-bs config set <key> <value>"
                exit 1
            fi
            
            config_write "$key" "$value" "$config_file"
            log_success "Set $key in profile '$profile'"
            ;;
        get)
            local key="$1"
            
            if [[ -z "$key" ]]; then
                log_error "Usage: patrol-bs config get <key>"
                exit 1
            fi
            
            local value
            if value=$(config_read "$key" "$config_file"); then
                echo "$value"
            else
                log_error "Key '$key' not found in profile '$profile'"
                exit 1
            fi
            ;;
        unset)
            local key="$1"
            
            if [[ -z "$key" ]]; then
                log_error "Usage: patrol-bs config unset <key>"
                exit 1
            fi
            
            config_remove "$key" "$config_file"
            log_success "Removed $key from profile '$profile'"
            ;;
        list)
            echo "Configuration (profile: $profile):"
            echo "  File: $config_file"
            echo ""
            config_list "$config_file"
            ;;
        path)
            echo "$config_file"
            ;;
        create)
            config_create_profile "$1"
            ;;
        use)
            config_use_profile "$1"
            ;;
        profiles)
            config_list_profiles
            ;;
        current)
            echo "$profile"
            ;;
        *)
            log_error "Unknown subcommand: $subcommand"
            echo "Run 'patrol-bs config --help' for usage information." >&2
            exit 1
            ;;
    esac
}

